# Copy this file to .env and set private values locally.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
DB_TYPE=sqlite
# For MySQL set DB_TYPE=mysql and fill these in:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=mahfooz_restaurant
# Or set DATABASE_URL to a provider connection string.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-deployment
RESTAURANT_ADDRESS=Patna, Bihar, India
RESTAURANT_PHONE=
RESTAURANT_UPI_ID=your-merchant-upi-id@bank
RESTAURANT_UPI_NAME=MAHFOOZ RESTAURANT PATNA
# Optional Razorpay credentials. Online payments are not activated in this starter build.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
